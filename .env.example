# Metadata voor scripts/create-cloudflare-config.mjs; geen geheime waarden.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=dp-proces
